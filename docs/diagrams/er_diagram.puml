@startuml
!theme plain
skinparam linetype ortho
skinparam nodesep 60
skinparam ranksep 80

skinparam class {
    BackgroundColor White
    BorderColor Black
    ArrowColor Black
    FontName Consolas
}

entity "UserRole" as UserRole {
  * roleID : int <<PK>>
  --
  name : str
}

entity "User" as User {
  * userID : int <<PK>>
  --
  name : str
  surname : str
  patronymik : str
  phone : str
  email : str
  password : str
  balance : float
  * roleID : int <<FK>>
}

entity "Tour" as Tour {
  * tourID : int <<PK>>
  --
  destination : str
  start_date : date
  end_date : date
  price : float
  seats_total : int
  seats_available : int
}

entity "Status" as Status {
  * statusID : int <<PK>>
  --
  name : str
}

entity "Booking" as Booking {
  * bookingID : int <<PK>>
  --
  * userID : int <<FK>>
  * tourID : int <<FK>>
  * managerID : int <<FK>>
  * statusID : int <<FK>>
  total_price : float
}

UserRole -- User
User -- Booking
User -- Booking
Tour -- Booking
Status -- Booking

@enduml